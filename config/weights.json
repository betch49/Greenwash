  "caps": {
    "claims": 100,
    "evidence": 100,
    "track": 100,
    "repair": 100
  },
  "claimsRate": {
    "perWords": 1000,
    "minWords": 1000,
    "subscorePerPointPer1000Words": 15,
    "version": 1,
    "v2": {
      "minClaims": 5,
      "insufficientDataStatus": "insufficient_data"
    }
  },
  "defaultWeightHint": 1,
  "regulatorRuling": {
    "baseHint": 1,
    "upheldMultiplier": 2,
    "recentYears": 3,
    "recentMultiplier": 1.5
  },
  "sbti": {
    "expiredMultiplier": 1
  },
  "litigation": {
    "$comment": "Phase 13 (ADR-028): litigation.case weight_hint = baseHint × the multiplier of the first rule whose keyword is a whole word of the case status as published (else of the last event; else unknownMultiplier) × regulatorRuling.recentMultiplier when filed within regulatorRuling.recentYears. A filed case is not a ruling: its points stay below regulator.ruling.",
    "baseHint": 1,
    "statusMultipliers": [
      { "keywords": ["dismissed", "withdrawn", "struck out"], "multiplier": 0 },
      { "keywords": ["pending", "filed", "ongoing"], "multiplier": 1 },
      { "keywords": ["decided", "judgment"], "multiplier": 1 }
    ],
    "unknownMultiplier": 1
  },
  "llmGuard": {
    "maxShare": 0.5
  },
  "llm": {
    "unsureWeightMultiplier": 0.5
  },
  "labels": {
    "moderateFrom": 25,
    "highFrom": 50
  },
  "confidence": {
    "axisSteps": {
      "claims": ["claims"],
      "evidence": ["evidence"],
      "track": ["wayback", "asa-uk", "jdp-fr", "sabin", "sbti"],
      "repair": ["repair", "fr-repair"]
    },
    "timelineCountsAsData": ["track"]
