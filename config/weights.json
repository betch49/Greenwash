      "claim.unsupported": 1,
      "claim.supported": 0.25
    },
    "evidence": {
      "evidence.no_report_found": 40,
      "evidence.stale_report": 25,
      "evidence.report_found": 0,
      "evidence.report_found_undated": 0,
      "evidence.absolute_emissions_found": 0,
      "evidence.supplier_list_found": 0
    },
    "track": {
      "claim.removed": 20,
      "regulator.ruling": 25,
      "sbti.commitment_removed": 15,
      "sbti.targets_validated": 0,
      "sbti.commitment_pending": 0,
      "sbti.status_note": 0,
      "litigation.case": 10,
      "regulator.ruling_other_topic": 0,
      "regulator.ruling_not_upheld": 0
    },
    "repair": {
      "repair.no_repair_info_found": 50,
