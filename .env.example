# Anthropic API key, used only by the LLM layer at runtime (Phase 7). Optional.
ANTHROPIC_API_KEY=
# Minimum spacing between Wayback Machine requests, in ms (never below 1000 for web.archive.org).
WAYBACK_RATE_LIMIT_MS=1000
# SQLite database file (cache, runs, reports). Default: data/greenwash.db
GR_DB_PATH=data/greenwash.db
# 1 = route every fetch to recorded fixtures and the LLM to the mock (offline mode, used by tests).
GR_OFFLINE_FIXTURES=
# A new search for a website with a report younger than this many hours re-serves that report (0 = always re-run). Default 168.
GR_REPORT_TTL_HOURS=168
# Model id for the AI steps. Default: config/llm.json ("claude-sonnet-5-5").
GR_LLM_MODEL=
# Spacing between requests to any one other host, in ms. Default 1000.
GR_RATE_LIMIT_MS=1000
# How long a fetched page / API answer / CDX listing is reused from the fetch cache, in hours. Default 168.
GR_CACHE_TTL_HOURS=168
# Offline mode only: pin the pipeline clock (ISO date-time), e.g. 2026-10-20T00:00:00Z. Ignored in live runs.
GR_FIXED_NOW=
